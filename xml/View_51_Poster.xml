				</control>
				<control type="image">
					<left>1</left>
					<top>1</top>
					<width>300</width>
					<height>300</height>
					<texture background="true">$INFO[ListItem.Art(discart)]</texture>
					<aspectratio>keep</aspectratio>
				</control>
