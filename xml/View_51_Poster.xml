							<top>17</top>
							<width>32</width>
							<height>32</height>
							<texture>$VAR[ListWatchedIconVar]</texture>
						</control>
						<control type="label">
							<left>630</left>
							<right>50</right>
							<height>40</height>
							<label>$VAR[ListLabelVar]</label>
							<font>font45_title</font>
							<shadowcolor>$VAR[ShadowColorVar]</shadowcolor>
							<scroll>true</scroll>
						</control>
					</control>
					<control type="group">
						<top>470</top>
						<visible>!ListItem.IsCollection</visible>
						<control type="image">
							<left>580</left>
							<top>17</top>
							<width>32</width>
							<height>32</height>
							<texture>$VAR[ListWatchedIconVar]</texture>
						</control>
						<control type="label">
							<left>630</left>
							<right>50</right>
							<height>40</height>
							<label>$VAR[ListLabelVar]$INFO[ListItem.Year, (,)]</label>
							<font>font45_title</font>
							<shadowcolor>$VAR[ShadowColorVar]</shadowcolor>
							<scroll>true</scroll>
						</control>
					</control>
					<control type="label">
						<left>40</left>
						<top>740</top>
						<width>485</width>
						<height>25</height>
						<align>center</align>
