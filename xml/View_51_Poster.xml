					<visible>!Skin.HasSetting(enable_LibraryDiscArtOverlay)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>302</width>
					<height>302</height>
					<texture background="true" colordiffuse="$VAR[GradientColorVar]">overlays/circle-302-gradient.png</texture>
					<aspectratio>keep</aspectratio>
					<visible>!Skin.HasSetting(enable_LibraryDiscArtOverlay)</visible>
