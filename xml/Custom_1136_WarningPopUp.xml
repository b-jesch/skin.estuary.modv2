<?xml version="1.0" encoding="utf-8"?>
<window type="dialog" id="1136">
	<defaultcontrol always="true">2</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<height>440</height>
			<width>1000</width>
			<include content="DialogBackgroundCommons">
				<param name="width" value="1000" />
				<param name="height" value="440" />
				<param name="header_label" value="$INFO[Window(home).Property(Popup_Header)]" />
				<param name="header_id" value="1" />
			</include>
			<control type="textbox">
				<left>30</left>
				<top>95</top>
				<width>940</width>
				<height>300</height>
				<shadowcolor>black</shadowcolor>
				<wrapmultiline>true</wrapmultiline>
				<pagecontrol>3000</pagecontrol>
				<font>font13</font>
				<label>$INFO[Window(home).Property(Popup_Text)]</label>
			</control>
			<control type="grouplist" id="9000">
				<orientation>horizontal</orientation>
				<left>0</left>
				<top>300</top>
				<width>1000</width>
				<align>center</align>
				<control type="button" id="2">
					<width>430</width>
					<height>100</height>
					<label>$LOCALIZE[106]</label>
					<font>font25_title</font>
					<textoffsetx>30</textoffsetx>

					<!-- Action sequence for button "No" -->
					<onclick>ClearProperty(PopUp_Header,home)</onclick>
					<onclick>ClearProperty(PopUp_Text,home)</onclick>
					<onclick>Dialog.Close(1136)</onclick>
					<!-- End of action sequence -->

					<align>center</align>
					<texturefocus border="40" colordiffuse="$VAR[SkinColorVar]">buttons/dialogbutton-fo.png</texturefocus>
					<texturenofocus border="40">buttons/dialogbutton-nofo.png</texturenofocus>
				</control>
				<control type="button" id="3">
					<width>430</width>
					<height>100</height>
					<label>$LOCALIZE[107]</label>
					<font>font25_title</font>
					<textoffsetx>30</textoffsetx>

					<!-- Action sequence for button "Yes" -->
					<onclick>ClearProperty(PopUp_Header,home)</onclick>
					<onclick>ClearProperty(PopUp_Text,home)</onclick>
					<onclick>Skin.ResetSettings</onclick>
					<onclick>ReloadSkin()</onclick>
					<onclick>Dialog.Close(1136)</onclick>
					<!-- End of action sequence -->

					<align>center</align>
					<texturefocus border="40" colordiffuse="$VAR[SkinColorVar]">buttons/dialogbutton-fo.png</texturefocus>
					<texturenofocus border="40">buttons/dialogbutton-nofo.png</texturenofocus>
				</control>
			</control>
		</control>
	</controls>
</window>